# Path to MKV sources (NAS share). Thumbnails live in ./thumbs, not on the NAS.
DRUMEO_MEDIA=/Volumes/private/Drumeo

# Optional bearer token for the video API
API_TOKEN=

# Shared secret between frontend and video-api for /api/admin. Only reachable on
# nginx's internal :8080. Generate one: openssl rand -hex 32
ADMIN_TOKEN=

# Password for Beheer (/admin). Empty disables admin. Profiles stay password-free.
ADMIN_PASSWORD=

# auto (probe GPU then CPU) | libx264 | h264_nvenc | h264_qsv | h264_vaapi | h264_videotoolbox
FFMPEG_VCODEC=auto

MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_VIDEO_TRANSCODES=1
JOB_TIMEOUT_SECONDS=14400
